# Diferentemente das listas, as tuplas são imutáveis.
# %%
dados_werbet = [43, "casado", 1.69]
print(dados_werbet)
# %%
# Nas listas, conseguimos adicionar elementos:
dados_werbet.append("3.800,00")
print(dados_werbet)
# %%
# Já nas tuplas, não conseguimos fazer mais nada. 
# A sintaxe é com ou sem parênteses.
tuplas_werbet = 43, "casado", 1.69
print(tuplas_werbet)
# %%
